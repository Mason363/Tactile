    <!--
      Sparkle reads this feed (Info.plist SUFeedURL) to decide whether a newer
      version exists. The newest <item> below advertises the shipping version,
      so "Check for Updates…" reports "up to date" until a newer item is added.

      To publish an update:
        1. Bump MARKETING_VERSION and CURRENT_PROJECT_VERSION in the project.
        2. Archive with Developer ID, notarize, and zip the .app.
        3. Sign the zip with Sparkle's sign_update to get the edSignature.
        4. Add a new <item> at the top with an <enclosure> pointing at the zip
           on the GitHub release, filling sparkle:version (CFBundleVersion),
           sparkle:shortVersionString, length (bytes), and sparkle:edSignature.
        5. Set SUPublicEDKey in Info.plist to the matching public key.
    -->
    <item>
      <title>Tactile 1.1.2</title>
      <pubDate>Sun, 13 Sep 2026 03:35:09 +0000</pubDate>
      <sparkle:minimumSystemVersion>14.6</sparkle:minimumSystemVersion>
      <sparkle:minimumAutoupdateVersion>4</sparkle:minimumAutoupdateVersion>
      <description><![CDATA[<p><strong>Your trackpad plays the music.</strong> Feel the Music is new: the trackpad's haptic motor plays the music's own notes under your finger, up to five at once, following its loudness. Talk and podcasts stay still.</p><ul><li>Vibrate while hovering holds a real note, with a new Pitch control.</li><li>Any step in the haptic maker can be a held note with its own pitch and length.</li><li>Ring and Shake are real tones now.</li><li>Sound Alerts: feel sounds you might not hear.</li></ul>]]></description>
      <enclosure url="https://github.com/Mason363/Tactile/releases/download/v1.1.2/Tactile-1.1.2.zip"
                 sparkle:version="7"
                 sparkle:shortVersionString="1.1.2"
                 length="3594238"
